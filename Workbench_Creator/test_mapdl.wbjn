# -*- coding: utf-8 -*-
# Test-Journal: MAPDL Edit + SendCommand testen

SetScriptVersion(Version="26.1")

print("TEST: Erstelle MAPDL-System...")
mapdl_template = GetTemplate(TemplateName="Mechanical APDL")
plate_system = mapdl_template.CreateSystem()
plate_system.DisplayText = "Test MAPDL"

setup_plate = plate_system.GetContainer(ComponentName="Setup")
print("TEST: Oeffne MAPDL Editor...")
setup_plate.Edit()
print("TEST: Sende /INPUT Befehl...")
setup_plate.SendCommand(Language="APDL", Command="/INPUT,plate_structural,inp,C:/Users/Moritz/Desktop/FEM/Aufgabe_1_2a_Plattenstruktur/out/")
print("TEST: Schliesse MAPDL Editor...")
setup_plate.Exit()
print("TEST: MAPDL fertig.")

Save(FilePath="Aufgabe_1_test_mapdl.wbpj", Overwrite=True)
print("TEST: Projekt gespeichert.")
